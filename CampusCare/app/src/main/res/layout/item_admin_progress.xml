<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_case"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Case #9022 - Power Outage"
            android:textSize="13sp"
            android:textColor="@color/admin_text" />

        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65%"
            android:textSize="12sp"
            android:textColor="@color/primary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progress="65"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="@color/admin_card2"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_assigned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assigned to: Mark S."
        android:textSize="11sp"
        android:textColor="@color/admin_text_secondary" />

</LinearLayout>
