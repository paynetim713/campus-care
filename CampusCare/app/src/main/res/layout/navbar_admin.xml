<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_drawer"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/admin_bg"
    android:orientation="vertical"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp"
        android:background="@color/admin_card">

        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:padding="10dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/white"
            android:contentDescription="Admin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_admin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin User"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/admin_text" />

            <TextView
                android:id="@+id/tv_admin_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator"
                android:textSize="12sp"
                android:textColor="@color/admin_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_overview"
            android:textSize="10sp"
            android:textColor="@color/admin_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/nav_dashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="8dp"
                android:src="@drawable/ic_dashboard"
                app:tint="@color/primary"
                android:contentDescription="Dashboard" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_users"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="8dp"
                android:src="@drawable/ic_users"
                app:tint="@color/primary"
                android:contentDescription="Users" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/users_management"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tickets"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="8dp"
                android:src="@drawable/ic_tickets"
                app:tint="@color/primary"
                android:contentDescription="Tickets" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_tickets"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_reviews"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="8dp"
                android:src="@drawable/ic_star"
                app:tint="@color/star_color"
                android:contentDescription="Reviews" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/technician_reviews"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_chat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="@color/primary"
                android:contentDescription="Chat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/admin_card2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_account"
            android:textSize="10sp"
            android:textColor="@color/admin_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_neutral_dark"
                android:padding="8dp"
                android:src="@drawable/ic_person"
                app:tint="@color/admin_text_secondary"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_profile"
                android:textSize="14sp"
                android:textColor="@color/admin_text"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_nav_item_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_red_dark"
                android:padding="8dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/status_new"
                android:contentDescription="Logout" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logout"
                android:textSize="14sp"
                android:textColor="@color/status_new"
                android:layout_marginStart="12dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>